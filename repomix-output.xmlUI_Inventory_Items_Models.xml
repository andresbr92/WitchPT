 76: void FCauldronIngredientList::SetIngredientAtSlot(int32 SlotIndex, UWitchPTInventoryItemInstance* Instance)
 77: {
 78:     for (FCauldronIngredientEntry& Entry : Entries)
 79:     {
 80:         if (Entry.SlotIndex == SlotIndex)
 81:         {
 82: 
 83:             Entry.IngredientInstance = Instance;
 84:             MarkItemDirty(Entry);
 85:             return;
 86:         }
 87:     }
 88: 
 89: 
 90:     FCauldronIngredientEntry& NewEntry = Entries.AddDefaulted_GetRef();
 91:     NewEntry.SlotIndex = SlotIndex;
 92:     NewEntry.IngredientInstance = Instance;
 93:     MarkArrayDirty();
 94: }
