 15: UUserWidget* UWitchPTUILayer::PushContent(TSubclassOf<UUserWidget> WidgetClass)
 16: {
 17: 	if (!WidgetClass)
 18: 	{
 19: 		UE_LOG(LogTemp, Warning, TEXT("PushContent: WidgetClass is null"));
