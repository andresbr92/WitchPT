 76: void UInventoryWidgetController::RemoveItemStack(UWitchPTInventoryItemInstance* ItemInstance, int32 AmountToRemove)
 77: {
 78: 	if (!ItemInstance)
 79: 	{
 80: 		return;
 81: 	}
 82: 
 83: 	AWitchPTPlayerController* WitchPtPlayerController = Cast<AWitchPTPlayerController>(PlayerController);
 84: 	if (!WitchPtPlayerController)
 85: 	{
 86: 		return;
 87: 	}
 88: 
 89: 	UWitchPTInventoryManagerComponent* InventoryManager = WitchPtPlayerController->GetInventoryManager();
 90: 	if (!InventoryManager)
 91: 	{
 92: 		return;
 93: 	}
 94: 
 95: 	const int32 CurrentStackCount = ItemInstance->GetTotalStackCount();
 96: 
 97: 
 98: 	if (CurrentStackCount <= 1 && AmountToRemove >= 1)
 99: 	{
100: 		InventoryManager->Server_RemoveItemInstance(ItemInstance);
101: 	}
102: 	else
103: 	{
104: 
105: 		InventoryManager->Server_RemoveItemStacks(ItemInstance, AmountToRemove);
106: 	}
