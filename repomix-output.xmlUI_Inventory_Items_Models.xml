 55: void UWitchPTInventoryManagerComponent::Server_UpdateItemStackCount_Implementation(UWitchPTInventoryItemInstance* ItemInstance, int32 NewCount)
 56: {
 57: 	if (IsValid(ItemInstance))
 58: 	{
 59: 		ItemInstance->SetTotalStackCount(NewCount);
 60: 
 61: 
 62: 		for (FWitchPTInventoryEntry& Entry : InventoryList.Entries)
 63: 		{
 64: 			if (Entry.Instance == ItemInstance)
 65: 			{
 66: 				InventoryList.MarkItemDirty(Entry);
 67: 				break;
 68: 			}
 69: 		}
 70: 
 71: 		if (GetOwner()->GetNetMode() == NM_ListenServer || GetOwner()->GetNetMode() == NM_Standalone)
 72: 		{
 73: 			OnItemStackChanged.Broadcast(ItemInstance);
 74: 		}
 75: 	}
