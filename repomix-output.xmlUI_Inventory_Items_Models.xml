 19: 		TSubclassOf<UWitchPTPrimaryLayout> LayoutWidgetClass = PrimaryLayoutClass.LoadSynchronous();
 20: 		if (ensure(LayoutWidgetClass && !LayoutWidgetClass->HasAnyClassFlags(CLASS_Abstract)))
 21: 		{
 22: 			UWitchPTPrimaryLayout* NewLayoutObject = CreateWidget<UWitchPTPrimaryLayout>(PlayerController, LayoutWidgetClass);
 23: 			RootViewportLayouts.Emplace(LocalPlayer, NewLayoutObject, true);
 24: 
 25: 			AddLayoutToViewport(LocalPlayer, NewLayoutObject);
 26: 		}
 27: 	}
 28: 
 29: }
 30: 
 31: void UWitchPT_GameUIPolicy::AddLayoutToViewport(ULocalPlayer* LocalPlayer, UWitchPTPrimaryLayout* Layout)
 32: {
 33: 	UE_LOG(LogTemp, Log, TEXT("[%s] is adding player [%s]'s to the viewport"), *GetName(), *GetNameSafe(LocalPlayer));
 34: 	Layout->SetPlayerContext(LocalPlayer);
 35: 	Layout->AddToPlayerScreen(1000);
 36: }
 37: 
 38: void UWitchPT_GameUIPolicy::RemoveLayoutFromViewport(ULocalPlayer* LocalPlayer, UWitchPTPrimaryLayout* Layout)
 39: {
 40: 	TWeakPtr<SWidget> LayoutSlateWidget = Layout->GetCachedWidget();
 41: 	if (LayoutSlateWidget.IsValid())
 42: 	{
 43: 		UE_LOG(LogTemp, Log, TEXT("[%s] is removing player [%s]'s root layout [%s] from the viewport"), *GetName(), *GetNameSafe(LocalPlayer), *GetNameSafe(Layout));
 44: 
 45: 		Layout->RemoveFromParent();
 46: 		if (LayoutSlateWidget.IsValid())
 47: 		{
 48: 			UE_LOG(LogTemp, Log, TEXT("Player [%s]'s root layout [%s] has been removed from the viewport, but other references to its underlying Slate widget still exist. Noting in case we leak it."),
 49: 				   *GetNameSafe(LocalPlayer), *GetNameSafe(Layout));
 50: 		}
 51: 
 52: 
 53: 	}
 54: }
 55: 
 56: void UWitchPT_GameUIPolicy::NotifyPlayerAdded(ULocalPlayer* LocalPlayer)
 57: {
 58: 	NotifyPlayerRemoved(LocalPlayer);
 59: 
 60: 	if (FRootViewportLayoutInfo* LayoutInfo = RootViewportLayouts.FindByKey(LocalPlayer))
 61: 	{
 62: 		AddLayoutToViewport(LocalPlayer, LayoutInfo->RootLayout);
 63: 		LayoutInfo->bIsAddedToViewport = true;
 64: 	} else
 65: 	{
 66: 		CreateLayoutWidget(LocalPlayer);
 67: 	}
 68: }
 69: 
 70: void UWitchPT_GameUIPolicy::NotifyPlayerRemoved(ULocalPlayer* LocalPlayer)
 71: {
 72: 	if (FRootViewportLayoutInfo* LayoutInfo = RootViewportLayouts.FindByKey(LocalPlayer))
 73: 	{
 74: 		RemoveLayoutFromViewport(LocalPlayer, LayoutInfo->RootLayout);
 75: 		LayoutInfo->bIsAddedToViewport = false;
 76: 
 77: 	}
 78: }
 79: 
 80: void UWitchPT_GameUIPolicy::AddContext(const ULocalPlayer* LocalPlayer,
 81: 	UWitchPT_GameUIContextBase* NewContext)
 82: {
 83: 	if (FRootViewportLayoutInfo* LayoutInfo = RootViewportLayouts.FindByKey(LocalPlayer))
 84: 	{
 85: 		if (UObject* ExistingContext = GetContext(LocalPlayer, NewContext->GetClass()))
 86: 		{
 87: 			UE_LOG(LogTemp, Warning, TEXT("[%s] is trying to add repeat context of type(%s) for %s, which is not allowed!"), *GetName(), *NewContext->GetName(), *GetNameSafe(LocalPlayer));
 88: 			return;
 89: 		}
 90: 		LayoutInfo->Contexts.Add(NewContext);
 91: 		UE_LOG(LogTemp, Warning, TEXT("[%s] registered context of type(%s) for %s."), *GetName(), *NewContext->GetClass()->GetName(), *GetNameSafe(LocalPlayer));
 92: 	}
 93: 
 94: }
 95: 
 96: void UWitchPT_GameUIPolicy::RemoveContext(const ULocalPlayer* LocalPlayer,
 97: 	TSubclassOf<UWitchPT_GameUIContextBase> ContextClass)
 98: {
 99: 	if (FRootViewportLayoutInfo* LayoutInfo = RootViewportLayouts.FindByKey(LocalPlayer))
100: 	{
101: 		int32 FoundContextIndex = INDEX_NONE;
102: 		for ( int32 i = 0; i < LayoutInfo->Contexts.Num(); i++)
103: 		{
104: 			if (LayoutInfo->Contexts[i] && LayoutInfo->Contexts[i]->GetClass() == ContextClass)
105: 			{
106: 				FoundContextIndex = i;
107: 				UE_LOG(LogTemp, Warning, TEXT("[%s] removed context of type(%s) for %s."), *GetName(), *ContextClass->GetName(), *GetNameSafe(LocalPlayer));
108: 				break;
109: 			}
110: 		}
111: 		LayoutInfo->Contexts.RemoveAt(FoundContextIndex);
112: 	}
113: }
114: 
115: UWitchPT_GameUIContextBase* UWitchPT_GameUIPolicy::GetContext(const ULocalPlayer* LocalPlayer,
116:                                                               TSubclassOf<UWitchPT_GameUIContextBase> ContextClass)
117: {
118: 	if (const FRootViewportLayoutInfo* LayoutInfo = RootViewportLayouts.FindByKey(LocalPlayer))
119: 	{
120: 		for (int32 i = 0; i < LayoutInfo->Contexts.Num(); i++)
121: 		{
122: 			if (LayoutInfo->Contexts[i] && LayoutInfo->Contexts[i]->GetClass() == ContextClass)
123: 			{
124: 				return LayoutInfo->Contexts[i];
125: 			}
126: 		}
127: 
128: 
129: 	}
130: 	return nullptr;
131: }
