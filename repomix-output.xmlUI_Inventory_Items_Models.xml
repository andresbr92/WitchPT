125: void UInventoryWidgetController::EquipItem(UWitchPTInventoryItemInstance* ItemInstance)
126: {
127: 	if (ItemInstance)
128: 	{
129: 		ACharacter* OwningCharacter = Cast<ACharacter>(PlayerController->GetPawn());
130: 		if (OwningCharacter)
131: 		{
132: 			UWitchPTEquipmentManagerComponent* EquipmentManager = OwningCharacter->FindComponentByClass<UWitchPTEquipmentManagerComponent>();
133: 			if (EquipmentManager)
134: 			{
135: 				UWitchPTEquipmentInstance* EquipmentInstance = EquipmentManager->FindEquipmentByInventoryItem(ItemInstance);
136: 				if (EquipmentInstance)
137: 				{
138: 					EquipmentManager->UnequipItem(EquipmentInstance);
139: 				}
140: 				else
141: 				{
142: 					const UWitchPTInventoryItemFragment* BaseFragment = ItemInstance->FindFragmentByClass(UWitchPTInventoryItemFragment_EquippableItem::StaticClass());
143: 					const UWitchPTInventoryItemFragment_EquippableItem* EquippableFragment = Cast<const UWitchPTInventoryItemFragment_EquippableItem>(BaseFragment);
144: 					EquipmentManager->EquipItem(EquippableFragment->EquipmentDefinition);
145: 				}
146: 			}
147: 		}
148: 		else
149: 		{
150: 			UE_LOG(LogTemp, Warning, TEXT("Owning character is not a valid ACharacter instance."));
151: 		}
152: 	}
153: }
