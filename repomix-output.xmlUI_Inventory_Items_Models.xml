244: 
245: bool UWitchPTInventoryManagerComponent::ReplicateSubobjects(class UActorChannel* Channel, class FOutBunch* Bunch,
246:                                                             FReplicationFlags* RepFlags)
247: {
248: 	bool WroteSomething = Super::ReplicateSubobjects(Channel, Bunch, RepFlags);
249: 
250: 	for (FWitchPTInventoryEntry& Entry : InventoryList.Entries)
251: 	{
252: 		UWitchPTInventoryItemInstance* Instance = Entry.Instance;
253: 
254: 		if (Instance && IsValid(Instance))
255: 		{
256: 			WroteSomething |= Channel->ReplicateSubobject(Instance, *Bunch, *RepFlags);
257: 		}
258: 	}
259: 
260: 	return WroteSomething;
261: }
262: 
263: void UWitchPTInventoryManagerComponent::ReadyForReplication()
264: {
265: 	Super::ReadyForReplication();
266: 
267: 	if (IsUsingRegisteredSubObjectList())
268: 	{
269: 		for (const FWitchPTInventoryEntry& Entry : InventoryList.Entries)
270: 		{
271: 			UWitchPTInventoryItemInstance* Instance = Entry.Instance;
272: 
273: 			if (IsValid(Instance))
274: 			{
275: 				AddReplicatedSubObject(Instance);
276: 			}
277: 		}
278: 	}
279: }
