217: bool UWitchPTInventoryManagerComponent::ConsumeItemsByDefinition(TSubclassOf<UWitchPTInventoryItemDefinition> ItemDef,
218: 	int32 NumToConsume)
219: {
220: 	AActor* OwningActor = GetOwner();
221: 	if (!OwningActor || !OwningActor->HasAuthority())
222: 	{
223: 		return false;
224: 	}
225: 
226: 
227: 	int32 TotalConsumed = 0;
228: 	while (TotalConsumed < NumToConsume)
229: 	{
230: 		if (UWitchPTInventoryItemInstance* Instance = UWitchPTInventoryManagerComponent::FindFirstItemStackByDefinition(ItemDef))
231: 		{
232: 			InventoryList.RemoveEntry(Instance);
233: 			++TotalConsumed;
234: 		}
235: 		else
236: 		{
237: 			return false;
238: 		}
239: 	}
240: 
241: 	return TotalConsumed == NumToConsume;
242: }
