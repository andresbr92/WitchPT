 55: void FCauldronIngredientList::NotifyIngredientChanged(int32 SlotIndex, UWitchPTInventoryItemInstance* Instance)
 56: {
 57:     if (UCauldronCraftComponent* CraftComponent = Cast<UCauldronCraftComponent>(OwnerComponent))
 58:     {
 59: 
 60:         switch (SlotIndex)
 61:         {
 62:         case 0:
 63:             CraftComponent->OnBaseIngredientSetDelegate.Broadcast(Instance);
 64:             break;
 65:         case 1:
 66:             CraftComponent->OnPrincipalIngredientSetDelegate.Broadcast(Instance);
 67:             break;
 68:         case 2:
 69:             CraftComponent->OnModifierIngredientSetDelegate.Broadcast(Instance);
 70:             break;
 71:         default: ;
 72:         }
 73:     }
 74: }
