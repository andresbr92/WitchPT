181: void UCauldronCraftComponent::TrySetIngredientInSlot(const ACharacter* RequestingCharacter, const TSubclassOf<UWitchPTInventoryItemDefinition>& IngredientItemDef)
182: {
183:     if (!GetOwner()->HasAuthority())
184:     {
185:         UE_LOG(LogTemp, Warning, TEXT("UCauldronCraftComponent::TrySetIngredientInSlot: Not authority"));
186:         return;
187:     }
188: 
189:     AWitchPTPlayerController* PC = Cast<AWitchPTPlayerController>(RequestingCharacter->GetController());
190:     if (!PC)
191:     {
192:         UE_LOG(LogTemp, Error, TEXT("UCauldronCraftComponent::TrySetIngredientInSlot: RequestingCharacter does not have a valid PlayerController."));
193:         return;
194:     }
195: 
196:     UWitchPTInventoryManagerComponent* InventoryManager = PC->GetInventoryManager();
197:     if (!InventoryManager)
198:     {
199:         UE_LOG(LogTemp, Error, TEXT("UCauldronCraftComponent::TrySetIngredientInSlot: Could not get InventoryManager from PlayerController."));
200:         return;
201:     }
202: 
203:     UWitchPTInventoryItemInstance* InstanceFromInventory = InventoryManager->FindFirstItemStackByDefinition(IngredientItemDef);
204: 
205:     if (!InstanceFromInventory)
206:     {
207:         UE_LOG(LogTemp, Warning, TEXT("UCauldronCraftComponent::TrySetIngredientInSlot: ItemDefinition %s not found in inventory for %s."), *IngredientItemDef->GetName(), *RequestingCharacter->GetName());
208:         return;
209:     }
210: 
211:     const UWitchPTInventoryItemFragment_IngredientCraftingProperties* IngredientCraftingDetails = Cast<UWitchPTInventoryItemFragment_IngredientCraftingProperties>(InstanceFromInventory->FindFragmentByClass(UWitchPTInventoryItemFragment_IngredientCraftingProperties::StaticClass()));
212:     if (!IngredientCraftingDetails)
213:     {
214:         UE_LOG(LogTemp, Warning, TEXT("UCauldronCraftComponent::TrySetIngredientInSlot: IngredientCraftingDetails is not valid for %s."), *RequestingCharacter->GetName());
215:         return;
216:     }
217: 
218: 
219:     const FWitchPTGameplayTags& GameplayTags = FWitchPTGameplayTags::Get();
220:     bool bIsBaseIngredient = IngredientCraftingDetails->SlotUsageTag.MatchesTag(GameplayTags.Item_Consumable_Ingredient_CanBeUsedIn_BaseSlot);
221:     bool bIsPrincipalIngredient = IngredientCraftingDetails->SlotUsageTag.MatchesTag(GameplayTags.Item_Consumable_Ingredient_CanBeUsedIn_PrincipalSlot);
222:     bool bIsModifierIngredient = IngredientCraftingDetails->SlotUsageTag.MatchesTag(GameplayTags.Item_Consumable_Ingredient_CanBeUsedIn_ModifierSlot);
223: 
224: 
225: 
226: 
227: 
228: 
229: 
230: 
231: 
232: 
233: 
234: 
235: 
236: 
237: 
238: 
239: 
240: 
241: 
242: 
243: 
244:     if (!bIsBaseIngredient && !bIsPrincipalIngredient && !bIsModifierIngredient)
245:     {
246:         UE_LOG(LogTemp, Warning, TEXT("UCauldronCraftComponent::TrySetIngredientInSlot: Ingredient %s doesn't have a valid slot usage tag"), *IngredientItemDef->GetName());
247:         return;
248:     }
249: 
250:     bool bConsumedSuccessfully = false;
251:     int32 CurrentStackCount = InstanceFromInventory->GetTotalStackCount();
252: 
253:     if (CurrentStackCount > 0)
254:     {
255:         UWitchPTInventoryItemInstance* IngredientToSet = nullptr;
256: 
257:         if (CurrentStackCount == 1)
258:         {
259:             IngredientToSet = InstanceFromInventory;
260:             InventoryManager->Server_RemoveItemInstance(InstanceFromInventory);
261:             bConsumedSuccessfully = true;
262:         }
263:         else
264:         {
265:             InventoryManager->Server_UpdateItemStackCount(InstanceFromInventory, CurrentStackCount - 1);
266:             IngredientToSet = InstanceFromInventory;
267:             bConsumedSuccessfully = true;
268:         }
269: 
270: 
271:         const UWitchPTInventoryFragment_UIDetails* UIFragment = Cast<UWitchPTInventoryFragment_UIDetails>(InstanceFromInventory->FindFragmentByClass(UWitchPTInventoryFragment_UIDetails::StaticClass()));
272:         TSubclassOf<UUserWidget> IngredientIcon = nullptr;
273:         if (IsValid(UIFragment))
274:         {
275:             IngredientIcon = UIFragment->IconWidget;
276:         }
277: 
278: 
279:         if (bIsBaseIngredient)
280:         {
281:             IngredientList.SetIngredientAtSlot(0, IngredientToSet);
282: 
283:             UE_LOG(LogTemp, Log, TEXT("UCauldronCraftComponent::TrySetIngredientInSlot: Base ingredient set successfully"));
284: 
285:             if (GetOwner()->HasAuthority())
286:             {
287:                 BroadcastBaseIngredientIconSet();
288:             }
289:         }
290:         else if (bIsPrincipalIngredient)
291:         {
292:             IngredientList.SetIngredientAtSlot(1, IngredientToSet);
293: 
294:             UE_LOG(LogTemp, Log, TEXT("UCauldronCraftComponent::TrySetIngredientInSlot: Principal ingredient set successfully"));
295: 
296:             if (GetOwner()->HasAuthority())
297:             {
298:                 BroadcastPrincipalIngredientIconSet();
299:             }
300:         }
301:         else if (bIsModifierIngredient)
302:         {
303:             IngredientList.SetIngredientAtSlot(2, IngredientToSet);
304: 
305:             UE_LOG(LogTemp, Log, TEXT("UCauldronCraftComponent::TrySetIngredientInSlot: Modifier ingredient set successfully"));
306: 
307:             if (GetOwner()->HasAuthority())
308:             {
309:                 BroadcastModifierIngredientIconSet();
310:             }
311:         }
312:     }
313: }
