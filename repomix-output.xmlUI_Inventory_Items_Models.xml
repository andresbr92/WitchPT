 68: void UMVVM_InventoryViewModel::EquipItem(UWitchPTInventoryItemInstance* ItemInstance)
 69: {
 70: 	if (ItemInstance)
 71: 	{
 72: 		if (ACharacter* OwningCharacter = Cast<ACharacter>(PlayerController->GetPawn()))
 73: 		{
 74: 			if (UWitchPTEquipmentManagerComponent* EquipmentManager = OwningCharacter->FindComponentByClass<UWitchPTEquipmentManagerComponent>())
 75: 			{
 76: 				if (UWitchPTEquipmentInstance* EquipmentInstance = EquipmentManager->FindEquipmentByInventoryItem(ItemInstance))
 77: 				{
 78: 					EquipmentManager->UnequipItem(EquipmentInstance);
 79: 				}
 80: 				else
 81: 				{
 82: 					const UWitchPTInventoryItemFragment* BaseFragment = ItemInstance->FindFragmentByClass(UWitchPTInventoryItemFragment_EquippableItem::StaticClass());
 83: 					const UWitchPTInventoryItemFragment_EquippableItem* EquipableFragment = Cast<const UWitchPTInventoryItemFragment_EquippableItem>(BaseFragment);
 84: 					EquipmentManager->EquipItem(EquipableFragment->EquipmentDefinition);
 85: 				}
 86: 			}
 87: 		}
 88: 	}
 89: }
 90: 
 91: void UMVVM_InventoryViewModel::RemoveItemStack(UWitchPTInventoryItemInstance* ItemInstance, int32 AmountToRemove)
 92: {
 93: 	if (!ItemInstance)
 94: 	{
 95: 		return;
 96: 	}
 97: 
 98: 	if (AWitchPTPlayerController* WitchPtPlayerController = Cast<AWitchPTPlayerController>(PlayerController))
 99: 	{
100: 		if (UWitchPTInventoryManagerComponent* InventoryManager = WitchPtPlayerController->GetInventoryManager())
101: 		{
102: 			const int32 CurrentStackCount = ItemInstance->GetTotalStackCount();
103: 
104: 
105: 			if (CurrentStackCount <= 1 && AmountToRemove >= 1)
106: 			{
107: 				InventoryManager->Server_RemoveItemInstance(ItemInstance);
108: 			}
109: 			else
110: 			{
111: 
112: 				InventoryManager->Server_RemoveItemStacks(ItemInstance, AmountToRemove);
113: 			}
114: 		}
115: 	}
116: }
</file>

